# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL — use Neon, Supabase, or Vercel Postgres in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/trackfix?schema=public"

# NextAuth v5 — must be a full https URL (not empty, not a relative path)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL=http://localhost:3000
# On Vercel: AUTH_URL=https://your-app.vercel.app (or omit and use trustHost + VERCEL_URL)
# Legacy alias (optional): NEXTAUTH_URL=https://your-app.vercel.app

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Google APIs (server-side integrations — optional for MVP stubs)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# Encryption for stored tokens (32-byte hex key)
ENCRYPTION_KEY=

# Vercel (auto-set in deployment)
# VERCEL_URL=
# VERCEL_ENV=
